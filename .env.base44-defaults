# The frontend connects to the local API server (api:3001) via the Vite proxy
# configured in vite.config.js. VITE_BASE44_APP_BASE_URL is intentionally left
# empty so that SDK auth redirects use relative URLs (which the Vite proxy
# forwards to the local backend).
VITE_BASE44_APP_ID=local-fleetlink-app
VITE_BASE44_APP_BASE_URL=
