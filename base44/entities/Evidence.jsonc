{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "carrier_id": {
      "type": "string"
    },
    "field_name": {
      "type": "string",
      "description": "The carrier field this evidence supports"
    },
    "field_value": {
      "type": "string"
    },
    "source_name": {
      "type": "string",
      "description": "SAFER, SMS, Company Website, etc."
    },
    "source_url": {
      "type": "string"
    },
    "source_page": {
      "type": "string",
      "description": "Which page/section the data came from"
    },
    "retrieval_date": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "carrier_id",
    "field_name"
  ]
}