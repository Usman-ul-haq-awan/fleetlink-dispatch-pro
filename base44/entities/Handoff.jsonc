{
  "name": "Handoff",
  "type": "object",
  "properties": {
    "carrier_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "mc_number": {
      "type": "string"
    },
    "usdot_number": {
      "type": "string"
    },
    "equipment": {
      "type": "string"
    },
    "lead_score": {
      "type": "number"
    },
    "safety_qualification": {
      "type": "string"
    },
    "trigger_source": {
      "type": "string",
      "description": "Email or Call that triggered the handoff"
    },
    "trigger_outcome": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Assigned",
        "Contacted",
        "Completed",
        "Lost"
      ],
      "default": "New"
    },
    "assigned_to": {
      "type": "string"
    },
    "is_hot_lead": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "carrier_id"
  ]
}