{
  "name": "AppNotification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "broadcast",
        "support",
        "reply"
      ],
      "default": "broadcast",
      "description": "broadcast = admin announcement to staff; support = staff message to admin; reply = admin reply to a specific staff member"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "all",
        "admin",
        "user"
      ],
      "default": "all"
    },
    "target_user_id": {
      "type": "string",
      "description": "When set, only this specific user sees the notification (used for admin replies to staff)"
    },
    "from_user_id": {
      "type": "string"
    },
    "from_user_name": {
      "type": "string"
    },
    "read_by": {
      "type": "string",
      "description": "Comma-separated user IDs who have read this notification"
    }
  },
  "required": [
    "title",
    "message"
  ]
}