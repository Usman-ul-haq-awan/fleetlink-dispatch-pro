{
  "name": "ImportBatch",
  "type": "object",
  "properties": {
    "batch_name": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "total_records": {
      "type": "number",
      "default": 0
    },
    "duplicates_found": {
      "type": "number",
      "default": 0
    },
    "missing_usdot": {
      "type": "number",
      "default": 0
    },
    "missing_mc": {
      "type": "number",
      "default": 0
    },
    "invalid_records": {
      "type": "number",
      "default": 0
    },
    "imported_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Processing",
        "Completed",
        "Failed",
        "Partial"
      ],
      "default": "Processing"
    },
    "column_mapping": {
      "type": "string",
      "description": "JSON string of column mapping"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "batch_name"
  ]
}