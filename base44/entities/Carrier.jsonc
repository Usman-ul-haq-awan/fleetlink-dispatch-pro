{
  "name": "Carrier",
  "type": "object",
  "properties": {
    "carrier_id": {
      "type": "string",
      "description": "Internal unique carrier identifier"
    },
    "legal_name": {
      "type": "string"
    },
    "dba_name": {
      "type": "string"
    },
    "usdot_number": {
      "type": "string",
      "description": "USDOT number"
    },
    "mc_number": {
      "type": "string"
    },
    "mx_number": {
      "type": "string"
    },
    "operating_status": {
      "type": "string"
    },
    "carrier_type": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "fax": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_title": {
      "type": "string"
    },
    "power_units": {
      "type": "number"
    },
    "drivers": {
      "type": "number"
    },
    "cargo_types": {
      "type": "string"
    },
    "carrier_segment": {
      "type": "string"
    },
    "equipment_types": {
      "type": "string",
      "description": "Comma-separated equipment types from evidence"
    },
    "equipment_quantity": {
      "type": "string"
    },
    "lead_status": {
      "type": "string",
      "enum": [
        "Imported",
        "Queued",
        "Researching",
        "SAFER Complete",
        "SMS Complete",
        "Registration Complete",
        "Insurance Complete",
        "Safety Complete",
        "Equipment Complete",
        "Contact Complete",
        "Qualified",
        "Needs Review",
        "Failed",
        "Ready for Outreach",
        "Contacted",
        "Interested",
        "Human Handoff",
        "Onboarding",
        "Active Client",
        "Do Not Contact"
      ],
      "default": "Imported"
    },
    "lead_score": {
      "type": "number",
      "default": 0
    },
    "lead_score_reasons": {
      "type": "string"
    },
    "safety_qualification": {
      "type": "string",
      "enum": [
        "Qualified",
        "Review Required",
        "High Risk",
        "Insufficient Data",
        "Not Assessed"
      ],
      "default": "Not Assessed"
    },
    "safety_reasons": {
      "type": "string"
    },
    "safety_positive_indicators": {
      "type": "string"
    },
    "safety_risk_flags": {
      "type": "string"
    },
    "safety_rating": {
      "type": "string"
    },
    "data_completeness": {
      "type": "string",
      "description": "Percentage or label of data completeness"
    },
    "research_status": {
      "type": "string",
      "description": "Current research step"
    },
    "safer_url": {
      "type": "string"
    },
    "sms_url": {
      "type": "string"
    },
    "last_researched_at": {
      "type": "string",
      "format": "date-time"
    },
    "do_not_contact": {
      "type": "boolean",
      "default": false
    },
    "dnc_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "email_funnel": {
      "type": "string",
      "description": "Assigned email sequence id (e.g. seq_1)"
    },
    "email_funnel_reason": {
      "type": "string",
      "description": "Why this funnel was selected for the carrier"
    },
    "email_sequence_step": {
      "type": "number",
      "default": 0,
      "description": "Current step in the sequence (0=not started, 1=initial sent, 2-4=follow-ups, 5=breakup)"
    },
    "email_next_send_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the next email in the sequence is due"
    },
    "email_sequence_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the full email sequence has been sent"
    },
    "email_first_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the initial email was sent"
    },
    "assigned_to_user_id": {
      "type": "string",
      "description": "User ID of the staff member this carrier is allocated to"
    },
    "assigned_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the carrier was allocated to the staff member"
    },
    "staff_comment": {
      "type": "string",
      "description": "Staff member's comment on the result of their approach to this carrier"
    },
    "staff_comment_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the staff comment was last updated"
    },
    "staff_lead_status": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Not Approached",
          "Approached",
          "Lead",
          "Dead Lead",
          "Follow-up",
          "Voicemail Left",
          "Hangup",
          "Onboard"
        ]
      },
      "description": "Staff-assigned lead classifications (multi-select) for back-office follow-up"
    },
    "lead_qual_status": {
      "type": "string",
      "enum": [
        "Hot Lead",
        "Warm Lead",
        "Qualified",
        "Ideal",
        "Not Qualified"
      ],
      "description": "Lead qualification status assigned by staff"
    },
    "follow_up_required": {
      "type": "string",
      "enum": [
        "Required",
        "Not Required"
      ],
      "description": "Whether a follow-up is required"
    },
    "callback_attempted": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "description": "Whether the carrier attempted a callback"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Not High"
      ],
      "description": "Lead priority"
    },
    "asset": {
      "type": "string",
      "enum": [
        "Yes",
        "Not"
      ],
      "description": "Whether the carrier is an asset"
    },
    "interest_level": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ],
      "description": "Carrier's expressed interest level"
    },
    "dispatch_needed": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Whether dispatch services are needed"
    },
    "truck_available": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Whether a truck is currently available"
    },
    "lead_equipment_type": {
      "type": "string",
      "enum": [
        "Dry Van",
        "Reefer",
        "Flatbed",
        "Box Truck",
        "Power Only",
        "Other",
        "Unknown"
      ],
      "description": "Lead qualification equipment type (staff-assigned)"
    },
    "number_of_trucks": {
      "type": "string",
      "enum": [
        "1",
        "2-5",
        "6-10",
        "10+"
      ],
      "description": "Number of trucks in the carrier's fleet"
    },
    "decision_maker_contacted": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "description": "Whether the decision maker was contacted"
    },
    "decision_maker": {
      "type": "string",
      "enum": [
        "Owner",
        "Driver",
        "Manager",
        "Dispatcher",
        "Other",
        "Unknown"
      ],
      "description": "Who the decision maker is"
    },
    "tycoon_service_fit": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "None"
      ],
      "description": "How well the carrier fits Tycoon's dispatch service"
    },
    "qualification_result": {
      "type": "string",
      "enum": [
        "Ideal",
        "Qualified",
        "Potential",
        "Needs Verification",
        "Not Qualified"
      ],
      "description": "Final lead qualification result"
    }
  },
  "required": [
    "carrier_id"
  ]
}